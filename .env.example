# Never commit real credentials. Reddit Data API access requires Reddit approval.
POE2_DB_PATH=data/poe2_alpha.db
POE2_SUBREDDIT=PathOfExile2
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:poe2-alpha-detector:0.1 (by /u/your_username)
OPENAI_API_KEY=

# Model routing
POE2_FAST_MODEL=gpt-5.6-luna
POE2_DEEP_MODEL=gpt-5.6-terra
POE2_EMBEDDING_MODEL=text-embedding-3-large
POE2_USE_OPENAI=true

# Tunable collection / clustering policy
POE2_LISTING_LIMIT=100
POE2_COMMENT_LIMIT=25
POE2_CLUSTER_THRESHOLD=0.82
POE2_WATCH_INTERVAL_SECONDS=600
